			"dist/nodes/Qova/Qova.node.js",
			"dist/nodes/Qova/QovaTrigger.node.js"
		]
	},
	"scripts": {
		"build": "tsc",
		"dev": "tsc --watch",
		"lint": "biome check src/",
		"test": "vitest run",
