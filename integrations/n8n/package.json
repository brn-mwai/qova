		"prepublishOnly": "npm run build"
	},
	"files": [
		"dist"
	],
	"peerDependencies": {
		"n8n-workflow": ">=1.0.0"
	},
	"devDependencies": {
		"n8n-workflow": "^2.10.2",
		"typescript": "^5.7.0",
		"vitest": "^3.0.0"
