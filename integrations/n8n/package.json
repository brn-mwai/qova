{
	"name": "n8n-nodes-qova",
	"version": "0.1.0",
	"description": "n8n community nodes for the Qova AI Agent Credit Bureau API",
	"license": "MIT",
	"author": "Qova Engineering <eng@qova.cc>",
	"homepage": "https://qova.cc",
	"repository": {
		"type": "git",
		"url": "https://github.com/qova-cc/qova",
		"directory": "integrations/n8n"
	},
	"keywords": [
		"n8n-community-node-package",
		"n8n",
		"qova",
		"ai-agents",
		"credit-bureau",
		"blockchain",
		"reputation"
	],
	"main": "dist/nodes/Qova/Qova.node.js",
	"n8n": {
		"n8nNodesApiVersion": 1,
